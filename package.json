{
  "name": "fovus-backend",
  "version": "1.0.0",
  "private": true,
  "main": "./server",
  "scripts": {
    "start": "nodemon",
    "build": "clean",
    "server": "NODE_PATH=. npx tsx server/bin/www.ts",
    "dev": "NODE_ENV=development DEBUG=*,-express:* npm-run-all server",
    "prod": "NODE_ENV=production npm-run-all build server",
    "clean": "rimraf dist",
    "transpile": "tsc",
    "endpoint-permission": "chmod +x server/bash/endpoints.sh",
    "sh-run": "server/bash/endpoint.sh",
    "export-endpoints": "npm run endpoint-permission && server/bash/endpoints.sh"
  },
  "nodemonConfig": {
    "exec": "npm run dev",
    "watch": [
      "server/*"
    ],
    "ignore": [
      "**/__tests__/**",
      "*.test.js",
      "*.spec.js"
    ],
    "ext": "ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.576.0",
    "@aws-sdk/s3-presigned-post": "^3.576.0",
    "@feathersjs/express": "^5.0.27",
    "@types/firebase": "^3.2.1",
    "aws-sdk": "^2.1620.0",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dayjs": "^1.11.11",
    "debug": "~2.6.9",
    "express": "^4.17",
    "express-formidable": "^1.2.0",
    "express-list-endpoints": "^7.1.0",
    "express-validator": "^7.1.0",
    "fast-json-patch": "^3.1.1",
    "firebase": "^10.12.2",
    "firebase-admin": "^12.2.0",
    "helmet": "^3.23.3",
    "ioredis": "^5.4.1",
    "lodash": "^4.17.21",
    "mongoose": "^8.4.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "parse-multipart-data": "^1.5.0",
    "ts-runtime": "^0.3.0",
    "uuid": "^9.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "1.4.2",
    "@types/cors": "^2.8.17",
    "@types/debug": "^4.1.12",
    "@types/express": "^4.17.21",
    "@types/helmet": "0.0.47",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.10",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "babel-jest": "^29.7.0",
    "dotenv": "^8.6.0",
    "eslint": "^7.32.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-airbnb-typescript": "^10.0.2",
    "eslint-plugin-import": "^2.29.1",
    "nodemon": "^2.0.22",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "rimraf": "^3.0.2",
    "shelljs": "^0.8.5",
    "ts-jest": "^29.1.5",
    "tslib": "^2.6.2",
    "tsx": "^4.10.2",
    "typescript": "^5.4.5"
  }
}
